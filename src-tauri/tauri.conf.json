{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0-community.4",
  "identifier": "com.springopen.deepseek-harness-desktop",
  "build": {
    "beforeDevCommand": "node scripts/with-pnpm.mjs dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/with-pnpm.mjs build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "COMMUNITY_BUILD_UPDATER_DISABLED"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI agent workspace",
    "longDescription": "Self-contained community desktop distribution for DeepSeek Harness.",
    "externalBin": ["binaries/node"],
    "resources": {
      "../runtime/staging/": "runtime/staging/"
    },
    "copyright": "Copyright 2026 SpringOpen Contributors",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
