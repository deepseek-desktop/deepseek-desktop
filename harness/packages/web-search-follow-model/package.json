      "inject": ["@deepseek-ai/dsh-client-ui-settings-plugins"],
      "external": ["react"]
    }
  },
  "files": ["index.js", "client.js"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-web": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
