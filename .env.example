# DeepSeek Desktop 可选构建配置示例
#
# 使用方法：
#   1. 将本文件复制为项目根目录下的 .env。
#   2. 只修改需要定制的配置，未填写的配置使用项目内置默认值。
#   3. 命令行环境变量优先级高于 .env，.env 优先级高于内置默认值。
#   4. 执行 `corepack pnpm@11.7.0 desktop:package` 一键完成当前平台打包。
#
# .env 仅供开发和构建阶段读取，不会被提交，也不得进入安装包、
# Runtime、诊断包或 BUILD-INFO.<target>.json。此文件不应填写 API Key 等敏感信息。

# -----------------------------------------------------------------------------
# 应用信息
# -----------------------------------------------------------------------------

# 用户可见的应用名称。
# 用于窗口标题、原生菜单、关于页面、安装包名称和应用目录名称。
DESKTOP_APP_NAME=DeepSeek Desktop

# 桌面应用版本，必须符合 SemVer。
# 允许使用 0.1.0-community.10 这类预发布版本。
DESKTOP_APP_VERSION=0.1.0-community.10

# Bundle Identifier，必须使用反向域名格式。
# 发布后不建议修改，否则会影响应用数据目录、升级识别和系统权限记录。
DESKTOP_APP_IDENTIFIER=deepseek.desktop

# 文件名、命令名和发布产物使用的短名称。
# 只允许小写字母、数字和连字符。
DESKTOP_APP_SLUG=deepseek-desktop

# 应用简短描述，用于安装包和系统应用信息。
DESKTOP_APP_DESCRIPTION=Local AI agent workspace

# 作者或维护者名称。多个作者使用英文逗号分隔。
DESKTOP_APP_AUTHORS=DeepSeek Desktop Contributors

# 唯一人工维护的源图标，相对项目根目录解析。
# 必须为正方形 PNG，至少 512 x 512，建议使用 1024 x 1024。
# 构建时由 app:sync 自动生成 macOS ICNS、Windows ICO 和平台尺寸 PNG。
DESKTOP_APP_ICON=src-tauri/icons/icon.png

# -----------------------------------------------------------------------------
# Harness Runtime 来源
# -----------------------------------------------------------------------------

# Harness 源码仓库。定制发行版可以替换为自己的 fork。
# runtime:sync 必须实际从该仓库构建 Runtime，不能只把地址写入来源说明。
HARNESS_REPOSITORY=https://github.com/deepseek-desktop/deepseek-harness.git

# Harness tag、commit 或开发分支。
# 正式发布时会解析并锁定为不可变 commit，同时记录 Runtime 完整性哈希。
HARNESS_REF=dsh-v0.1.1-rc.2
